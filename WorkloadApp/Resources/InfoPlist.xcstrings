    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa never writes data to Apple Health. This notice is required because the sign-in flow references a HealthKit API that can request write access; Tuwa only ever requests read access."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa 不会向 Apple 健康写入任何数据。由于授权流程引用了可请求写入权限的 HealthKit 接口，系统要求提供此说明；Tuwa 只会请求读取权限。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa reads your heart rate variability, resting heart rate, sleep, workout heart rate, body temperature, and VO2 Max to calculate your daily recovery score and training load."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa 读取您的心率变异性、静息心率、睡眠、训练心率、体温和最大摄氧量数据，用于计算每日恢复评分和训练负荷。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}