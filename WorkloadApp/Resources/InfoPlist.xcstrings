{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa reads your heart rate variability, resting heart rate, sleep, workout heart rate, body temperature, and VO2 Max to calculate your daily recovery score and training load."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonus 读取您的心率、心率变异性和睡眠数据，用于计算每日恢复评分。这些原始数据不会离开您的设备。"
          }
        }
      }
    }
  }
}
