    "cycle.fueling.fasted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid hard sessions fasted — fuel before high-intensity work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高强度训练前先补充能量，避免空腹进行。"
          }
        }
      }
    },
    "cycle.fueling.lutealHeat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may run warmer this phase — prioritize hydration and cooling during hard efforts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一阶段体温可能偏高——大强度训练时注意补水和降温。"
          }
        }
      }
    },
    "cycle.fueling.lutealNutrition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little extra protein and complex carbs can help this phase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一阶段适量增加蛋白质和复合碳水会有帮助。"
          }
        }
      }
    },
    "cycle.fueling.protein": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim for protein within ~45 minutes after training."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练后约 45 分钟内补充蛋白质。"
          }
        }
      }
    },
    "cycle.fueling.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fueling & recovery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补给与恢复"
          }
        }
