    "recommendation.detail.activeRecoveryLoad" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body needs recovery. Light movement (Zone 1-2 cardio, mobility work, foam rolling) only. Reduce volume by 50% and cap intensity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的身体需要恢复。仅进行轻度活动（第 1-2 区有氧运动、活动度工作、筋膜放松）。将训练量减少 50%，上限强度。"
          }
        }
      }
    },
    "recommendation.detail.activeRecoveryStrain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Readiness is low. Keep to light movement (Zone 1-2, mobility, foam rolling). Reduce volume by 50%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备度较低。保持轻度活动（第 1-2 区、活动度、筋膜放松）。将训练量减少 50%。"
          }
        }
      }
    },
    "recommendation.detail.buildGradually" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Readiness is moderate and accumulated strain is low. Progressively build capacity, but don't push past RPE 8."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备度中等，积累压力较低。逐步增加容量，但不要超过 RPE 8。"
          }
        }
      }
    },
    "recommendation.detail.buildLoadGradually" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your chronic load is low. Use today to progressively build capacity, but don't push past RPE 8 given moderate recovery."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的慢性负荷较低。利用今天逐步增加容量，但鉴于中等恢复，不要超过 RPE 8。"
          }
        }
      }
    },
    "recommendation.detail.buildYourBase" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're fresh and your chronic load is low. Great opportunity to progressively build training capacity. Push toward RPE 9."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你精力充沛，慢性负荷较低。这是逐步增加训练容量的好机会。推向 RPE 9。"
          }
        }
      }
    },
    "recommendation.detail.fatigueElevated" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accumulated training stress suggests lighter work today. Active recovery will help you come back stronger."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积累的训练压力表明今天应该进行较轻的工作。主动恢复将帮助你更强势地回归。"
          }
        }
      }
    },
    "recommendation.detail.fatigueElevatedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accumulated training stress suggests your body needs lighter work today. Active recovery will help you come back stronger."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积累的训练压力表明你的身体今天需要较轻的工作。主动恢复将帮助你更强势地回归。"
          }
        }
      }
    },
    "recommendation.detail.feelingGoodHighStrain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Readiness is high, but accumulated strain is high relative to your tolerance. Don't let good readiness mask it — train at 75% volume, stay controlled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备度较高，但相对于你的承受力，积累压力较高。不要让良好的准备度掩盖它 — 以 75% 训练量进行训练，保持控制。"
          }
        }
      }
