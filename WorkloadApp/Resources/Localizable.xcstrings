    "sleep.detail.about.scoring.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How sleep affects your score"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠如何影响你的评分"
          }
        }
      }
    },
    "sleep.detail.about.sixHour.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below 6 hours, sleep pulls your recovery score down steeply — each lost hour costs about half again what it costs above 6 hours. One short night is recoverable; three in a week is a pattern worth acting on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低于 6 小时，睡眠会显著拉低你的恢复评分——每少睡一小时的评分代价约是 6 小时以上区间的一倍半。偶尔一晚睡眠不足可以补回；一周内出现三次则是需要注意的情况。"
          }
        }
      }
    },
    "sleep.detail.about.sixHour.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the 6-hour line means"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 小时线的含义"
          }
        }
      }
    },
    "sleep.detail.about.target.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seven and a half hours is where sleep stops holding your readiness back. Sleep research generally recommends 7 to 9 hours for adults, and more is better if you can get it — 7.5 is the line Tuwa scores against, so that is the line the chart draws."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7.5 小时是睡眠不再拖累你准备度的临界点。睡眠研究普遍建议成年人睡 7 至 9 小时，能睡更久更好——7.5 小时是 Tuwa 评分所依据的标准，所以图表画的是这条线。"
          }
        }
      }
    },
    "sleep.detail.about.target.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why 7.5 hours is the target"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么目标是 7.5 小时"
          }
        }
      }
    },
    "sleep.detail.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep below 6 hours pulls your recovery score down steeply. The 7.5-hour target line is where sleep stops holding your readiness back — it is the point Tuwa scores a green sleep contribution from."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠少于 6 小时会显著拉低你的恢复评分。7.5 小时目标线是睡眠不再拖累准备度的临界点——Tuwa 从这一点开始将睡眠计为绿色贡献。"
          }
        }
      }
    },
