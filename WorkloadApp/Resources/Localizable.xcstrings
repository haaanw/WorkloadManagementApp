    "hrv.chart.empty.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No HRV data available. Connect a wearable device through Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无可用的心率变异性数据。通过 Apple 健康连接穿戴设备。"
          }
        }
      }
    },
    "hrv.detail.about.baseline.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absolute HRV varies enormously between people — 30 ms can be excellent for one athlete and poor for another. Tuwa compares you only against your own rolling 7-day average, so the number that matters is the deviation, not the reading."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同人的心率变异性绝对值差异极大——30 ms 对一个运动员可能很好，对一个普通人就可能偏低。Tuwa 只将你与自己的 7 日滚动平均值比较，所以真正重要的是偏离幅度，而不是数据本身的高低。"
          }
        }
      }
    },
    "hrv.detail.about.baseline.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why your baseline is personal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么基准线因人而异"
          }
        }
      }
    },
    "hrv.detail.about.deviation.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single reading below baseline is usually noise — alcohol, a late meal, a bad night. Two or three in a row alongside a raised resting heart rate is the pattern that means fatigue, and that is what your readiness score is already weighing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次低于基准线的读数通常只是噪音——饮酒、晚餐吃太晚、睡得不好。连续两三次且伴随静息心率升高，才是提示疲劳的模式，而这正是你的准备度评分在监测的内容。"
          }
        }
      }
    },
    "hrv.detail.about.deviation.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a deviation means"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏离基准线意味着什么"
          }
        }
      }
    },
    "hrv.detail.about.measures.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What HRV measures"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率变异性是在测量什么"
          }
        }
      }
    },
    "hrv.detail.about.window.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa scores HRV from morning readings only (before 11:00), using the day's median. HRV rises through the day, so daytime and evening readings would distort your baseline. Apple Health averages every reading in the day, which is why its number often runs higher. Both are correct — they answer different questions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa 只使用早晨（11:00 前）的 HRV 读数，取当天的中位数。HRV 会随一天时间升高，混入白天和晚间的读数会扭曲你的基线。Apple Health 平均全天所有读数，所以它的数字通常更高。两者都是正确的——它们回答的是不同的问题。"
          }
        }
      }
    },
    "hrv.detail.about.window.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why this differs from Apple Health"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为何与 Apple Health 不同"
          }
        }
      }
    },
    "hrv.detail.delta.vsAvg" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
