          }
        }
      }
    },
    "cycle.reds.dismiss.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss cycle pattern notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略周期变化提示"
          }
        }
      }
    },
    "cycle.reds.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle pattern change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周期规律变化"
          }
        }
      }
    },
    "cyclePhase.context.follicular": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in your follicular phase — HRV and recovery markers tend to run higher. Your readiness score reflects your own same-phase normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正处于卵泡期——心率变异性和恢复指标通常会偏高。你的状态评分已参照你同阶段的个人基线。"
          }
        }
      }
    },
    "cyclePhase.context.luteal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in your luteal phase — lower HRV and a higher resting heart rate are expected here. Your readiness score already accounts for this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正处于黄体期——心率变异性偏低、静息心率偏高都属正常。你的状态评分已将此考虑在内。"
          }
        }
      }
    },
    "cyclePhase.earlyFollicular": {
