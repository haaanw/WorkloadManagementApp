          }
        }
      }
    },
    "trends.meaning.fatigue.zone.elevated" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body is carrying more than it has cleared over this window."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这个窗口里，你的身体背着的比它消化掉的更多。"
          }
        }
      }
    },
    "trends.meaning.fatigue.zone.high" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accumulated fatigue is well above your usual sitting point, and several of the six signals are elevated at once."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累积疲劳明显高于你平时所处的位置，六项信号中有几项同时偏高。"
          }
        }
      }
    },
    "trends.meaning.fatigue.zone.low" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are carrying little accumulated fatigue: the six signals behind this index are near or below where they usually sit for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你身上累积的疲劳很少：这个指数背后的六项信号，都接近或低于你平时的水平。"
          }
        }
      }
    },
    "trends.meaning.fatigue.zone.veryHigh" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sits near the top of the 0–100 scale: load, rest and recovery signals are all elevated together."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个读数接近 0–100 量表的顶端：负荷、休息和恢复信号同时偏高。"
          }
        }
      }
    },
    "trends.meaning.load.building" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last week has run ahead of the month behind it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近一周走在了它前面那一个月的前面。"
          }
        }
      }
    },
    "trends.meaning.load.high" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last week is at least half again the daily average of the month behind it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近一周至少是它前面一个月日均值的一倍半。"
          }
        }
      }
    },
    "trends.meaning.load.light" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last week has been lighter than the month behind it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近一周比它前面的一个月更轻。"
          }
        }
      }
    },
    "trends.meaning.load.noData" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough chronic load yet to form a ratio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢性负荷还不够，暂时形成不了比值。"
          }
        }
      }
    },
    "trends.meaning.load.steady" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your last week is in line with the month behind it. 0.8–1.3 is the band that reads as a continuation of work you have already done."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近一周和它前面的一个月一致。0.8–1.3 这个区间读起来，是你已经做过的训练的延续。"
          }
        }
      }
    },
