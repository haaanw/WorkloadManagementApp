    "sleep.night.about.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa reads the night from one source — the device that recorded the most sleep — and joins its samples into a single session. Overlapping samples count once, and afternoon naps are kept separate from the night. Apple Health sometimes adds together every source and every session, so its daily total can differ from the number here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuwa 只读取记录睡眠最多的那一个设备，并把它的样本合并为一段睡眠。重叠的样本只计一次，午睡与夜间睡眠分开统计。Apple Health 有时会把所有来源和所有片段加在一起，因此其每日总计可能与这里的数字不同。"
          }
        }
      }
    },
