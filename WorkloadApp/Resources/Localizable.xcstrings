    "recommendation.detail.activeRecoveryLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body needs recovery. Light movement (Zone 1-2 cardio, mobility work, foam rolling) only. Reduce volume by 50% and cap intensity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的身体需要恢复。仅进行轻度活动（第 1-2 区有氧运动、活动度工作、筋膜放松）。将训练量减少 50%，上限强度。"
          }
        }
      }
    },
    "recommendation.detail.activeRecoveryStrain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is low. Keep to light movement (Zone 1-2, mobility, foam rolling). Reduce volume by 50%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备度较低。保持轻度活动（第 1-2 区、活动度、筋膜放松）。将训练量减少 50%。"
          }
        }
      }
    },
    "recommendation.detail.buildGradually": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is moderate and accumulated strain is low. Progressively build capacity, but don't push past RPE 8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备度中等，积累压力较低。逐步增加容量，但不要超过 RPE 8。"
          }
        }
      }
    },
    "recommendation.detail.buildLoadGradually": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chronic load is low. Use today to progressively build capacity, but don't push past RPE 8 given moderate recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的慢性负荷较低。利用今天逐步增加容量，但鉴于中等恢复，不要超过 RPE 8。"
          }
        }
      }
    },
    "recommendation.detail.buildYourBase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're fresh and your chronic load is low. Great opportunity to progressively build training capacity. Push toward RPE 9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你精力充沛，慢性负荷较低。这是逐步增加训练容量的好机会。推向 RPE 9。"
          }
        }
      }
    },
    "recommendation.detail.fatigueElevated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accumulated training stress suggests lighter work today. Active recovery will help you come back stronger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积累的训练压力表明今天应该进行较轻的工作。主动恢复将帮助你更强势地回归。"
          }
        }
      }
    },
    "recommendation.detail.fatigueElevatedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accumulated training stress suggests your body needs lighter work today. Active recovery will help you come back stronger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积累的训练压力表明你的身体今天需要较轻的工作。主动恢复将帮助你更强势地回归。"
          }
        }
      }
    },
    "recommendation.detail.feelingGoodHighStrain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is high, but accumulated strain is high relative to your tolerance. Don't let good readiness mask it — train at 75% volume, stay controlled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备度较高，但相对于你的承受力，积累压力较高。不要让良好的准备度掩盖它 — 以 75% 训练量进行训练，保持控制。"
          }
        }
      }
    },
    "recommendation.detail.feelingGoodLoadHigh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is great, but recent load is elevated relative to your baseline. Don't let good recovery mask accumulated fatigue. Train at 75% volume, stay controlled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复很好，但最近的负荷相对于你的基线较高。不要让良好的恢复掩盖积累的疲劳。以 75% 训练量进行训练，保持控制。"
          }
        }
      }
    },
    "recommendation.detail.fullRestLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is low and recent load is elevated. Focus on sleep, nutrition, and parasympathetic activities (breathing drills, light walking)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复较低，最近的负荷较高。专注于睡眠、营养和副交感神经活动（呼吸练习、轻步行）。"
          }
        }
      }
    },
    "recommendation.detail.fullRestStrain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is low and accumulated strain is high. Prioritize sleep, nutrition, and parasympathetic recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备度较低，且积累的压力较高。优先考虑睡眠、营养和副交感神经恢复。"
          }
        }
      }
    },
    "recommendation.detail.goZoneFullyReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is high and accumulated strain is low. Great day for PR attempts, high-intensity intervals, plyometrics, or max-effort training."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备度较高，积累压力较低。适合尝试个人最佳、高强度间隔训练、增强式训练或最大努力训练的日子。"
          }
        }
      }
    },
    "recommendation.detail.goZoneRecoveryHigh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is high and your load is steady relative to baseline. Good day for PR attempts, high-intensity intervals, plyometrics, or max effort training."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复较高，你的负荷相对于基线保持稳定。适合尝试个人最佳、高强度间隔训练、增强式训练或最大努力训练的日子。"
          }
        }
      }
    },
    "recommendation.detail.lightDayHighStrain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is moderate and accumulated strain is high. Reduce volume by 50% and keep intensity low — a deload opportunity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备度中等，积累压力较高。将训练量减少 50%，保持强度较低 — 这是一个减负的机会。"
          }
        }
      }
    },
    "recommendation.detail.lightDayLoadHigh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent load is elevated and recovery is moderate. Reduce volume by 50% and keep intensity low. Consider this a deload opportunity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的负荷较高，恢复中等。将训练量减少 50%，保持强度较低。将此视为减负的机会。"
          }
        }
      }
    },
    "recommendation.detail.moderateControlledLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is fair but load is building. Maintain volume at 75% and cap RPE at 7. Avoid max effort sets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复一般，但负荷在增加。将训练量保持在 75%，RPE 上限为 7。避免最大努力组。"
          }
        }
      }
    },
    "recommendation.detail.moderateControlledStrain": {
