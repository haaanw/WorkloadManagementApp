    "cycle.reds.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cycle patterns have changed recently. This can sometimes mean your body needs more fuel or recovery. It may be worth speaking with a healthcare provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你近期的月经周期规律发生了变化。这有时意味着身体需要更多能量或恢复。建议咨询医疗专业人士。"
          }
        }
      }
    },
    "cycle.reds.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
